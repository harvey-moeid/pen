{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "penalty-battle-3d",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MatchRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "penalty-battle-assets",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "secrets": {
    "required": ["ADMIN_SECRET", "WEBHOOK_SIGNING_SECRET"],
  },
}
